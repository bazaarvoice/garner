<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GarnerTestApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appName}"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.bazaarvoice.push.APP_ID"
            android:value="${bvAppId}" />
        <meta-data
            android:name="com.bazaarvoice.push.BASE_URL"
            android:value="${bvBaseUrl}" />
        <meta-data
            android:name="com.bazaarvoice.push.CLOUD_PROJECT_NUMBER"
            android:value="@string/bv_cloud_project_number" />
    </application>

</manifest>
